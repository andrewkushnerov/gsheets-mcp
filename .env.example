# ---------------------------------------------------------------------------
# gsheets-mcp configuration. Copy to .env and fill in.
# Every value is optional — the defaults run a local, unauthenticated,
# read/write server on http://127.0.0.1:8077/mcp
# ---------------------------------------------------------------------------

# --- How the server talks to Google -----------------------------------------
# Pick ONE of the two. OAuth is the default: the server acts as *you* and sees
# the spreadsheets you already own. A service account is the right choice for a
# server (no browser, no token refresh dance), at the cost of a longer setup.

# 1) OAuth desktop client (default). Run `python scripts/google_authorize.py`
#    once, it opens a browser and writes GOOGLE_TOKEN_FILE. After that the
#    server refreshes the token on its own and never needs a browser again.
GOOGLE_OAUTH_CLIENT_FILE=./credentials.json
GOOGLE_TOKEN_FILE=./token.json

# 2) Service account (for servers).
#    Share each spreadsheet with the service account's client_email as Editor.
#    Takes precedence over the OAuth token when set.
# GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json

# --- HTTP transport ---------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8077

# Bearer token required on every request to /mcp. Leave empty to disable auth
# (fine on localhost — NEVER expose an unauthenticated server to the internet).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Comma-separated browser origins allowed to POST /mcp. Anything else with an
# Origin header gets 403 — the guard against DNS rebinding, where a page on the
# open web points its own domain at 127.0.0.1 and reaches a local server as
# same-origin. Loopback origins are always allowed, and clients that send no
# Origin at all (Claude Code, curl, a reverse proxy) are unaffected, so leave
# this empty unless a browser app talks to the server directly.
MCP_ALLOWED_ORIGINS=

# --- Guard rails ------------------------------------------------------------
# true  -> only the read tools are registered; the write tools do not exist at all
#          (the model cannot call what it cannot see).
GSHEETS_READ_ONLY=false

# Comma-separated spreadsheet ids the server is allowed to touch.
# Empty = any spreadsheet the Google identity above can open.
GSHEETS_ALLOWED_SPREADSHEETS=

# Page size for gsheets_read_sheet, and the ceiling on its `limit` argument, so
# one fat tab cannot blow up the model's context window. Reads above this come
# back a page at a time with the offset to continue from. 0 = no limit, no paging.
GSHEETS_MAX_READ_ROWS=5000

# Wire format for sheet contents: tsv (default) or json. The same 1000x8 table
# costs ~37k tokens as indented JSON and ~16k as TSV, and the API hands back every
# cell as a string anyway, so nothing is lost. Switch to json only if something
# downstream parses the tool output instead of reading it.
GSHEETS_OUTPUT_FORMAT=tsv

# true -> registers gsheets_find_spreadsheets, which looks up a spreadsheet id in
#         Drive by name. Off by default: it is the one tool that lets the model
#         discover documents you never handed it.
# Turning it on needs two one-offs: enable the Drive API in the same Cloud project,
# and re-run `python scripts/google_authorize.py` (the token remembers its scopes,
# and the extra one is drive.metadata.readonly — names and ids, never contents).
GSHEETS_ENABLE_DRIVE_SEARCH=false

LOG_LEVEL=INFO
